DOMAIN_NAME=aurodrig.42.fr

MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# Passwords (en campus usamos .env; en VM puedes migrar a secrets/)
MYSQL_PASSWORD=wp_pass
MYSQL_ROOT_PASSWORD=root_pass

# WordPress auto-install (WP-CLI)
# VM final / local con /etc/hosts apuntando: https://aurodrig.42.fr
WP_URL=https://aurodrig.42.fr

# Titulo del sitio
WP_TITLE=Inception

# Admin (no usar "admin" en el nombre)
WP_ADMIN_USER=aurodrig
WP_ADMIN_PASSWORD=123456
WP_ADMIN_EMAIL=aurodrig@student.42.fr

# Usuario normal (no admin)
WP_USER=aurodrig_user
WP_USER_PASSWORD=123456
WP_USER_EMAIL=aurodrig_user@student.42.fr

# FTP bonus (servicio FTP para acceder al volumen de WordPress)
FTP_USER=ftpuser
FTP_PASSWORD=ftp_pass_42
