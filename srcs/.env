# ==========================================================
# .env - Variables de entorno del stack Inception (intra3)
# ==========================================================
#
# QUE ES ESTE ARCHIVO
# -------------------
# Este fichero centraliza configuracion para docker-compose y scripts setup.sh.
# Permite cambiar credenciales/hosts/urls sin editar codigo fuente.
#
# IMPORTANTE
# ----------
# - No usar credenciales reales en repositorio publico.
# - Para entorno final, puedes migrar passwords a `secrets/`.
# - Los valores aqui son leidos en runtime por los contenedores.
# ==========================================================

# Dominio del sitio principal servido por NGINX.
# Se usa en certificados y en configuracion general de WordPress.
DOMAIN_NAME=aurodrig.42.fr

# -------------------------
# MariaDB / MySQL variables
# -------------------------

# Nombre de la base de datos que usara WordPress.
MYSQL_DATABASE=wordpress

# Usuario de aplicacion (WordPress) para acceder a la DB.
MYSQL_USER=wp_user

# Password del usuario de aplicacion.
MYSQL_PASSWORD=wp_pass

# Password de root en MariaDB.
# Se usa para tareas administrativas e inicializacion idempotente.
MYSQL_ROOT_PASSWORD=root_pass

# -------------------------
# WordPress auto-install
# -------------------------

# URL base usada por `wp core install`.
# En este entorno local usas 9443; en VM final suele ser https://<login>.42.fr
WP_URL=https://127.0.0.1:9443

# Titulo visible del sitio WordPress.
WP_TITLE=Inception

# -------------------------
# Usuario administrador WP
# -------------------------

# Login del admin inicial.
# Recomendacion de evaluacion: evitar nombres tipo "admin".
WP_ADMIN_USER=aurodrig

# Password del admin inicial.
WP_ADMIN_PASSWORD=123456

# Email del admin inicial.
WP_ADMIN_EMAIL=aurodrig@student.42.fr

# -------------------------
# Usuario normal WP
# -------------------------

# Login de usuario no administrador (p. ej. subscriber).
WP_USER=aurodrig_user

# Password del usuario normal.
WP_USER_PASSWORD=123456

# Email del usuario normal.
WP_USER_EMAIL=aurodrig_user@student.42.fr

# -------------------------
# FTP (bonus)
# -------------------------

# Usuario del servicio FTP para gestionar archivos del volumen WordPress.
FTP_USER=ftpuser

# Password FTP del usuario anterior.
FTP_PASSWORD=ftp_pass_42

# ==========================================================
# CONCLUSION (ESTUDIO RAPIDO)
# ==========================================================
#
# - Este archivo alimenta todo el stack; si un valor esta mal,
#   puede romper MariaDB, WordPress, NGINX o bonus.
# - En fallos de arranque, revisa primero coherencia entre:
#   1) .env
#   2) docker-compose.yml
#   3) scripts setup.sh de cada servicio
# ==========================================================
